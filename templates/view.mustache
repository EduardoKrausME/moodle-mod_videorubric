{{!
    @template mod_videorubric/view
    Example context (json):
    {"activityname":"Video rubric","hasintro":false,"isgrader":false}
}}
<h2>{{activityname}}</h2>

{{#hasintro}}
    <div class="generalbox mod_introbox">{{{intro}}}</div>
{{/hasintro}}

{{#isgrader}}
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-secondary" href="{{{reviewurl}}}">{{#str}}reviewsubmissions, mod_videorubric{{/str}}</a>
        <a class="btn btn-secondary" href="{{{rubricurl}}}">{{#str}}managerubric, mod_videorubric{{/str}}</a>
    </div>
{{/isgrader}}

{{^isgrader}}
    <div class="alert alert-info">{{status}}</div>
    <a class="btn btn-secondary" href="{{{submissionurl}}}">{{#str}}opensubmission, mod_videorubric{{/str}}</a>

    {{#hasfeedback}}
        <section class="mt-4">
            <h3>{{#str}}feedback, mod_videorubric{{/str}}</h3>
            <div class="h5">{{#str}}finalscore, mod_videorubric{{/str}}: {{finalscore}}</div>
            {{#hasfeedbacktext}}<div>{{{feedbacktext}}}</div>{{/hasfeedbacktext}}
            {{#hasaudio}}<audio controls src="{{{audiourl}}}" class="w-100 mt-3"></audio>{{/hasaudio}}
        </section>
    {{/hasfeedback}}
{{/isgrader}}
