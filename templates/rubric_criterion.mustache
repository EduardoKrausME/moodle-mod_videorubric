{{!
    @template mod_videorubric/rubric_criterion
    Example context (json):
    {"index":0,"id":0,"name":"","description":"","weight":"1","levels":[]}
}}
<section class="card mb-3 videorubric-criterion" data-index="{{index}}">
    <div class="card-body">
        <input type="hidden" name="criteria[{{index}}][id]" value="{{id}}">
        <div class="d-flex justify-content-between align-items-start gap-3">
            <div class="flex-grow-1">
                <label class="form-label">{{#str}}criterion, mod_videorubric{{/str}}</label>
                <input class="form-control mb-2" name="criteria[{{index}}][name]" value="{{name}}" required>
                <textarea class="form-control mb-2" name="criteria[{{index}}][description]" rows="2"
                    placeholder="{{#str}}description{{/str}}">{{description}}</textarea>
                <label class="form-label">{{#str}}weight, mod_videorubric{{/str}}</label>
                <input class="form-control videorubric-weight" type="number" min="0" step="0.01"
                    name="criteria[{{index}}][weight]" value="{{weight}}">
            </div>
            <button type="button" class="btn btn-outline-danger videorubric-remove-criterion">
                {{#str}}remove{{/str}}
            </button>
        </div>
        <div class="videorubric-levels mt-3">
            {{#levels}}
                {{> mod_videorubric/rubric_level}}
            {{/levels}}
        </div>
        <button type="button" class="btn btn-outline-primary videorubric-add-level">
            {{#str}}addlevel, mod_videorubric{{/str}}
        </button>
    </div>
</section>
